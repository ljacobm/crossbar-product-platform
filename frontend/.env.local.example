# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shopify webhook (frontend/app/api/webhooks/shopify/route.ts)
# "Client secret" in current Shopify terminology -- found on the app's
# credentials page in the Shopify admin/partner dashboard. Used to verify
# the X-Shopify-Hmac-Sha256 header on incoming webhook deliveries. Never
# expose this with a NEXT_PUBLIC_ prefix.
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret

# Optional defense-in-depth check: if set, incoming webhook deliveries must
# have a matching X-Shopify-Shop-Domain header (e.g. your-store.myshopify.com).
# Not required for authentication -- SHOPIFY_CLIENT_SECRET/HMAC verification
# is what actually authenticates the request.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# Shopify historical order backfill (frontend/scripts/backfillShopifyOrders.ts,
# frontend/lib/shopifyAdminClient.ts). Client ID from the same app
# credentials page as SHOPIFY_CLIENT_SECRET above -- together with that
# secret and SHOPIFY_SHOP_DOMAIN, used to obtain an Admin API access token
# via Shopify's client-credentials grant. Requires the read_all_orders scope
# to be granted to the app (see the Phase 3A plan) before importing orders
# older than ~60 days.
SHOPIFY_CLIENT_ID=your-shopify-client-id
