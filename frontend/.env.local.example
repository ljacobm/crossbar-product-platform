# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shopify webhook (frontend/app/api/webhooks/shopify/route.ts)
# "Client secret" in current Shopify terminology -- found on the app's
# credentials page in the Shopify admin/partner dashboard. Used to verify
# the X-Shopify-Hmac-Sha256 header on incoming webhook deliveries. Never
# expose this with a NEXT_PUBLIC_ prefix.
SHOPIFY_CLIENT_SECRET=your-shopify-client-secret

# Optional defense-in-depth check: if set, incoming webhook deliveries must
# have a matching X-Shopify-Shop-Domain header (e.g. your-store.myshopify.com).
# Not required for authentication -- SHOPIFY_CLIENT_SECRET/HMAC verification
# is what actually authenticates the request.
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com

# Phase 1, Milestone 2: Shopify order lifecycle sync
# (frontend/lib/shopifyLifecycleFlags.ts). Server-side only -- never
# prefixed NEXT_PUBLIC_. Comma-separated allowlist of which NEW webhook
# topics are actually processed: orders/updated, orders/cancelled,
# orders/edited, fulfillments/create, fulfillments/update,
# refunds/create. Unset/empty means none of them are -- a recognized
# but not-yet-enabled topic is recorded in shopify_webhook_events and
# marked processed, exactly like an unrecognized topic, never partially
# applied. Does NOT gate orders/create, which is unconditional and
# unaffected by this flag either way. Leave unset until: (1) the
# corresponding database/migrations/20261026_add_shopify_order_lifecycle_sync.sql
# migration (and its two corrective patches) has been applied to the
# target environment, and (2) the relevant topic has actually been
# subscribed on the Shopify side (not done as part of this milestone).
# Example: SHOPIFY_LIFECYCLE_TOPICS_ENABLED=orders/updated,orders/cancelled
SHOPIFY_LIFECYCLE_TOPICS_ENABLED=

# Phase 1, Milestone 2: independently gates whether discount data is
# ever written, even for an enabled order-lifecycle topic above. Unset
# or any value other than exactly "true" means discounts are treated as
# "not provided" on every order touch (SQL NULL, "no opinion") --
# existing discount rows, if any, are left untouched; never "confirmed
# empty," which would incorrectly clear them.
SHOPIFY_CAPTURE_DISCOUNTS=false

# Shopify historical order backfill (frontend/scripts/backfillShopifyOrders.ts,
# frontend/lib/shopifyAdminClient.ts). Client ID from the same app
# credentials page as SHOPIFY_CLIENT_SECRET above -- together with that
# secret and SHOPIFY_SHOP_DOMAIN, used to obtain an Admin API access token
# via Shopify's client-credentials grant. Requires the read_all_orders scope
# to be granted to the app (see the Phase 3A plan) before importing orders
# older than ~60 days.
SHOPIFY_CLIENT_ID=your-shopify-client-id

# Staff authentication (frontend/app/login/actions.ts). The app's own
# canonical URL -- used to build the magic-link's emailRedirectTo
# (`${NEXT_PUBLIC_SITE_URL}/auth/callback`). Must exactly match an entry in
# the Supabase project's Authentication -> URL Configuration -> Redirect
# URLs allowlist, or Supabase will reject the redirect. Use
# http://localhost:3000 for local development and the real production
# domain in Vercel's environment variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Customer Fundraising Portal (frontend/lib/portalFeatureFlag.ts). Server-
# side only -- deliberately NOT prefixed NEXT_PUBLIC_, so it never reaches
# the client bundle. The single global switch for the whole portal, for
# every online_store_id (Phase 4E -- there is no per-store allowlist):
# when exactly "true", staff can generate/regenerate/retrieve links and
# customers with a valid token can view their store's dashboard; any
# other value (including unset) fails closed -- public access is denied
# and staff can no longer generate or regenerate (revoking an existing
# link always stays available regardless of this flag, and existing
# tokens are not automatically deleted when it's turned off).
PORTAL_PUBLIC_ROUTE_ENABLED=false

# Customer Fundraising Portal persistent link retrieval
# (frontend/lib/portalTokenCrypto.ts). Server-side only -- deliberately NOT
# prefixed NEXT_PUBLIC_. Base64-encoded 32 random bytes (generate with
# `openssl rand -base64 32`), used as the AES-256-GCM key for a second,
# separately-encrypted copy of each portal token, stored alongside its
# SHA-256 hash so staff can retrieve and re-copy the same active link later
# without regenerating it. REQUIRED for generatePortalLink/
# regeneratePortalLink to succeed at all: if this is unset, malformed, or
# encryption otherwise fails, link creation/rotation is refused outright
# (a generic staff-facing error, no token created, no existing token
# deactivated) -- it is no longer best-effort. Existing customer token
# validation (token_hash lookup) never reads this key and is unaffected
# either way, so a previously issued link keeps working for customers
# regardless of this key's state. Rotating this key makes every
# previously-encrypted copy undecryptable; there is no migration path for
# that today, by design (losing retrievability for existing links is the
# accepted tradeoff, not a silent data loss of the tokens themselves,
# which remain valid via their hash regardless).
PORTAL_TOKEN_ENCRYPTION_KEY=
